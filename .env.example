# FieldMind AI — environment template
# Copy this file to .env and fill in your own values.
# .env files are git-ignored. Never commit a real key.

# GEMINI_API_KEY: Required for the server-side model calls that power
# FieldMind Diagnosis, the FieldMind Assistant, and service-report generation.
# Read only on the server (see server/geminiService.ts) and never sent to the
# browser. If it is missing, the app still runs and falls back to the local
# knowledge base.
GEMINI_API_KEY=""

# APP_URL: The public URL where this app is hosted. Used for self-referential
# links. Hosting platforms typically inject this at runtime; leave the
# placeholder alone unless you are hosting it yourself.
APP_URL="MY_APP_URL"

# FieldMind AI (Android) — environment template
# Copy this file to .env and fill in your own value. .env is git-ignored.
#
# GEMINI_API_KEY: optional. Enables cloud-assisted diagnosis and the FieldMind
# Assistant. Without it the app falls back to its on-device reasoning engine and
# knowledge base.
#
# IMPORTANT: uncomment the line below only if you want the key baked into the
# build. While it stays commented out, no key is packaged into the APK — the
# safer option is to enter the key at runtime under
# Settings > Enterprise Backend Configuration.
# GEMINI_API_KEY=MY_GEMINI_API_KEY
